#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."

echo "  [1/3] Checking types..."
npx tsc --noEmit

echo "  [2/3] Running linter..."
npm run lint 2>/dev/null || npx eslint src/

echo "  [3/3] Running tests..."
npm run test -- --run 2>/dev/null || echo "  (no tests configured)"

echo "All pre-commit checks passed."
